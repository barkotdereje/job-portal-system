 <!-- Job Seeker Profile Servlet -->
<servlet>
    <servlet-name>JobSeekerProfileServlet</servlet-name>
    <servlet-class>com.jobportal.JobSeekerProfileServlet</servlet-class>
    <!-- Add multipart config for file upload -->
    <multipart-config>
        <max-file-size>5242880</max-file-size> <!-- 5MB -->
        <max-request-size>5242880</max-request-size>
        <file-size-threshold>0</file-size-threshold>
    </multipart-config>
</servlet>
<servlet-mapping>
    <servlet-name>JobSeekerProfileServlet</servlet-name>
    <url-pattern>/JobSeekerProfileServlet</url-pattern>
</servlet-mapping>
    
